main_file: "examples/classifier_cifar10/main_lsq.py"
arch: "resnet20"
model_source: Local
log_name: "temp"
debug: false
data: "./CIFAR-10"
lr: 0.01
epochs: 100
batch_size: 256
workers: 8
print_freq: 40
evaluate: false
pretrained: true

gpu_id: ANY
multi_gpu {
    world_size: 1
    rank: 0
    dist_url: "tcp://localhost:29500"
    dist_backend: "nccl"
    multiprocessing_distributed: true
}

nbits_w: 3
nbits_a: 3
nbits_alpha: 8
wbitslice: 1
abitslice: 1
xbar: 128
adcbits: 1.5
stochastic_quant: False


lr_scheduler: CosineAnnealingLR

optimizer: SGD
sgd {
  weight_decay: 1e-4
  momentum: 0.9
}


