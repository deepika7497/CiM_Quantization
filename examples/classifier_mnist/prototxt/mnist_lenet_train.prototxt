main_file: "examples/classifier_mnist/main.py"
arch: "mnist_lenet"
model_source: Local

log_name: "ternary"
debug: false
data: "./MNIST"
lr: 0.01
epochs: 100
batch_size: 256
workers: 16
print_freq: 50
evaluate: false
pretrained: false
seed: 0
gpu_id: ANY


nbits_w: 4
nbits_a: 4
nbits_alpha: 0
wbitslice: 1
abitslice: 1
xbar: 8
adcbits: 1.5
stochastic_quant: false
first_layer: true

lr_scheduler: CosineAnnealingLR
resume : "/home/min/a/saxenau/NANO/CiM_Quantization/logger/mnist_1xlenet_baseline/mnist_lenet_Conv2dLSQCiMbest.pth.tar"


optimizer: SGD
sgd {
  weight_decay: 1e-4
  momentum: 0.9
}